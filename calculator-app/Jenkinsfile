pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage("Build") {
      steps {
        dir("calculator-app") {
          bat "npm install"
          bat "npm test"
          bat "npm run build"
        }
      }
    }
  }

  post {
    success {
      archiveArtifacts artifacts: "calculator-app/dist/**", fingerprint: true
    }
  }
}
